# App
NEXT_PUBLIC_CITY_NAME=India
NEXT_PUBLIC_DEFAULT_LAT=22.9734
NEXT_PUBLIC_DEFAULT_LNG=78.6569
ADMIN_PIN=1234

# AWS — leave unset to run fully locally (disk storage + heuristic AI)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 photo storage
S3_BUCKET=ecoguardian-reports
S3_PUBLIC_BASE_URL=

# Amazon Rekognition labels + Amazon Bedrock (Claude) for issue/severity
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
USE_REKOGNITION=true
USE_BEDROCK=true

# Optional SNS fan-out to departments
SNS_TOPIC_ARN=
